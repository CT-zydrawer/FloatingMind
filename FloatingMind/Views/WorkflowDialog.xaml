<Window x:Class="FloatingMind.WorkflowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Workflow 可视化"
        Height="550" Width="750" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource DarkRegionBrush}"
                Padding="14,12" CornerRadius="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtWorkflowName" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock x:Name="TxtWorkflowDesc" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <Border Grid.Column="1" HorizontalAlignment="Right" Padding="12,5"
                        CornerRadius="6" Background="{DynamicResource PrimaryBrush}">
                    <TextBlock x:Name="TxtStatus" Foreground="White" FontWeight="Bold" FontSize="13" />
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="WorkflowNodesList" Margin="30,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Border Padding="16,12" CornerRadius="10" MinWidth="220"
                                    Background="{DynamicResource DarkRegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="{Binding SourceLabel}" FontWeight="Bold" FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SourceAgent}" FontSize="10"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="▼" FontSize="20" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,4" />
                            <Border Padding="16,12" CornerRadius="10" MinWidth="220"
                                    Background="{DynamicResource DarkRegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="{Binding TargetLabel}" FontWeight="Bold" FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TargetAgent}" FontSize="10"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource DarkRegionBrush}"
                Padding="12,10" CornerRadius="6" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Width="14" Height="14" CornerRadius="3" Background="#FF52C41A" />
                    <TextBlock Text=" 完成" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Width="14" Height="14" CornerRadius="3" Background="#FF1890FF" />
                    <TextBlock Text=" 运行中" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Width="14" Height="14" CornerRadius="3" Background="#FFFF4D4F" />
                    <TextBlock Text=" 失败" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="3"
                            Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text=" 等待中" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
